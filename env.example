# Copy this file to .env for local testing (Railway uses its own dashboard vars, not this file)

# Any random string you make up yourself. Must match what you enter in the Meta dashboard.
VERIFY_TOKEN=my_super_secret_verify_token_123

# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_TOKEN=your_temporary_or_permanent_access_token

# From Meta App Dashboard > WhatsApp > API Setup
PHONE_NUMBER_ID=your_phone_number_id
